# ─── 依赖 ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── 敏感配置（绝不入库）────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.production
# 生产配置（含密钥，绝不入库）
# 注意：.gitignore 不支持行尾内联注释，注释必须单独成行
.env.prod

# ─── 构建产物 ────────────────────────────────────────
dist/
build/
.next/
out/

# ─── 上传 / 运行时文件 ──────────────────────────────
uploads/
*.sqlite
*.sqlite-journal

# ─── 日志 ───────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── 编辑器 / IDE ───────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ─── 测试覆盖率 ─────────────────────────────────────
coverage/
.nyc_output/

# ─── TypeScript 增量编译缓存 ────────────────────────
*.tsbuildinfo

# ─── 数据库备份（含全量数据，绝不入库）───────────
backup/

# ─── setup-ssl.sh 运行时生成（含服务器绝对路径）─────
scripts/renew-ssl.sh

# ─── SSL 证书（含私钥，绝不入库）───────────────────
nginx/ssl/

# ─── 杂项 ───────────────────────────────────────────
.cache/
.turbo/
